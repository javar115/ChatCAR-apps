<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
  let isScanning = false;
  let validaciones = [];
  let countdownTimer = null;

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3000);
  }

  function startScanner() {
    if (isScanning) return;
    isScanning = true;

    document.getElementById('scannerIdle').style.display = 'none';
    document.getElementById('cameraFeed').classList.add('active');
    document.getElementById('btnScan').classList.add('scanning');
    document.getElementById('btnScan').innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/></svg> Escaneando...';
    document.getElementById('statusDot').className = 'status-dot green';
    document.getElementById('statusText').textContent = 'Cámara activa — esperando QR';
    document.getElementById('btnStop').classList.add('show');
  }

  function stopScanner() {
    isScanning = false;
    document.getElementById('scannerIdle').style.display = 'flex';
    document.getElementById('cameraFeed').classList.remove('active');
    document.getElementById('resultValid').classList.remove('show');
    document.getElementById('resultInvalid').classList.remove('show');
    document.getElementById('btnScan').classList.remove('scanning');
    document.getElementById('btnScan').innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/><rect x="7" y="7" width="10" height="10" rx="1"/></svg> Iniciar escáner';
    document.getElementById('statusDot').className = 'status-dot gray';
    document.getElementById('statusText').textContent = 'Escáner inactivo';
    document.getElementById('btnStop').classList.remove('show');
    if (countdownTimer) clearInterval(countdownTimer);
  }

  function simulateResult(valid) {
    if (!isScanning) startScanner();

    // Hide both overlays first
    document.getElementById('resultValid').classList.remove('show');
    document.getElementById('resultInvalid').classList.remove('show');

    // Log validation
    const now = new Date();
    const timeStr = now.toLocaleTimeString('es-AR', {hour:'2-digit', minute:'2-digit', second:'2-digit'});
    const id = 'CHCAR-' + Math.floor(1000 + Math.random() * 9000);
    validaciones.unshift({ valid, time: timeStr, id });
    updateHistorial();
    updateStats();

    // Show result
    const overlayId = valid ? 'resultValid' : 'resultInvalid';
    const countdownId = valid ? 'countdownValid' : 'countdownInvalid';
    document.getElementById(overlayId).classList.add('show');

    // Countdown
    let seconds = 3;
    document.getElementById(countdownId).textContent = seconds;
    if (countdownTimer) clearInterval(countdownTimer);
    countdownTimer = setInterval(() => {
      seconds--;
      document.getElementById(countdownId).textContent = seconds;
      if (seconds <= 0) {
        clearInterval(countdownTimer);
        document.getElementById(overlayId).classList.remove('show');
      }
    }, 1000);

    showToast(valid ? '✓ Validación registrada — Cuenta activa' : '✗ Validación registrada — Cuenta inactiva');
  }

  function updateHistorial() {
    const list = document.getElementById('historialList');
    if (validaciones.length === 0) return;

    list.innerHTML = validaciones.slice(0, 20).map(v => `
      <div class="historial-item">
        <div class="hist-result-icon ${v.valid ? 'valid' : 'invalid'}">
          ${v.valid ? '✓' : '✗'}
        </div>
        <div class="hist-info">
          <div class="hist-result-text ${v.valid ? 'valid' : 'invalid'}">
            ${v.valid ? 'Cuenta activa' : 'Cuenta inactiva'}
          </div>
          <div class="hist-time">${v.time}</div>
        </div>
        <div class="hist-id">${v.id}</div>
      </div>
    `).join('');

    const todayCount = validaciones.length;
    document.getElementById('histCount').textContent = todayCount + (todayCount === 1 ? ' hoy' : ' hoy');
  }

  function updateStats() {
    document.getElementById('statHoy').textContent = validaciones.length;
    document.getElementById('statMes').textContent = 87 + validaciones.length;
    document.getElementById('statTotal').textContent = 341 + validaciones.length;
  }
</script>
</body>
</html>
