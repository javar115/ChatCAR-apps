<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ChatCAR — Panel Comercio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --red:#CC1F1F;--red-dark:#9B1717;--red-light:#FDEAEA;
      --white:#FFFFFF;--off-white:#F7F4F0;--black:#111111;
      --gray:#555555;--gray-light:#AAAAAA;--border:#E2DCDC;
      --success:#059669;--success-bg:#ECFDF5;
      --success-dark:#047857;
      --danger:#DC2626;--danger-bg:#FEF2F2;
    }
    body{font-family:"Barlow",sans-serif;background:var(--off-white);min-height:100vh;color:var(--black)}

    /* ── TOPBAR ── */
    .topbar{
      position:sticky;top:0;z-index:100;
      background:var(--white);border-bottom:1.5px solid var(--border);
      padding:0 5vw;height:64px;
      display:flex;align-items:center;justify-content:space-between;
    }
    .topbar-left{display:flex;align-items:center;gap:14px}
    .topbar-logo{display:flex;align-items:center;gap:10px;text-decoration:none}
    .topbar-logo img{width:36px;height:36px;border-radius:9px;object-fit:cover}
    .topbar-logo-name{font-family:"Bebas Neue",sans-serif;font-size:1.5rem;letter-spacing:1px;color:var(--black)}
    .topbar-sep{width:1px;height:28px;background:var(--border)}
    .topbar-biz{font-size:0.82rem;font-weight:700;color:var(--gray)}
    .topbar-right{display:flex;align-items:center;gap:10px}
    .topbar-nav a{
      font-size:0.82rem;font-weight:600;color:var(--gray);
      text-decoration:none;padding:6px 14px;border-radius:8px;transition:all 0.2s;
    }
    .topbar-nav a:hover,.topbar-nav a.active{background:var(--red-light);color:var(--red)}
    .topbar-avatar{
      width:34px;height:34px;border-radius:50%;
      background:var(--black);
      display:flex;align-items:center;justify-content:center;
      color:white;font-weight:700;font-size:0.75rem;cursor:pointer;
    }

    /* ── LAYOUT ── */
    .layout{
      max-width:1100px;margin:0 auto;
      padding:2rem 2rem 3rem;
      display:grid;
      grid-template-columns:1fr 380px;
      gap:2rem;
      align-items:start;
    }

    /* ── SCANNER SECTION ── */
    .scanner-section{display:flex;flex-direction:column;gap:1.5rem}

    .section-header{margin-bottom:0.2rem}
    .section-tag{
      font-size:0.72rem;font-weight:700;text-transform:uppercase;
      letter-spacing:0.15em;color:var(--red);margin-bottom:0.5rem;
      display:flex;align-items:center;gap:8px;
    }
    .section-tag::before{content:"";width:18px;height:2px;background:var(--red)}
    .section-title{
      font-family:"Bebas Neue",sans-serif;
      font-size:2.2rem;line-height:1;color:var(--black);
    }

    /* ── SCANNER CARD ── */
    .scanner-card{
      background:var(--white);
      border:1.5px solid var(--border);
      border-radius:20px;overflow:hidden;
      animation:fadeUp 0.5s ease both;
    }
    @keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

    .scanner-top{
      padding:1.8rem 2rem 1.4rem;
      border-bottom:1px solid var(--border);
      display:flex;align-items:center;justify-content:space-between;
      flex-wrap:wrap;gap:1rem;
    }
    .scanner-top-left h3{
      font-family:"Barlow Condensed",sans-serif;
      font-size:1.1rem;font-weight:800;
      text-transform:uppercase;letter-spacing:0.06em;
      margin-bottom:3px;
    }
    .scanner-top-left p{font-size:0.82rem;color:var(--gray)}

    .btn-scan{
      display:flex;align-items:center;gap:10px;
      background:var(--red);color:white;
      border:none;padding:13px 28px;
      border-radius:12px;font-weight:700;font-size:0.95rem;
      cursor:pointer;font-family:"Barlow",sans-serif;
      transition:all 0.2s;
    }
    .btn-scan:hover{background:var(--red-dark);transform:translateY(-1px)}
    .btn-scan.scanning{background:var(--gray);cursor:not-allowed;transform:none}

    /* Scanner viewport */
    .scanner-viewport{
      position:relative;
      background:var(--black);
      min-height:320px;
      display:flex;align-items:center;justify-content:center;
      overflow:hidden;
    }
    .scanner-idle{
      display:flex;flex-direction:column;align-items:center;
      gap:1rem;color:rgba(255,255,255,0.4);
      padding:3rem;text-align:center;
    }
    .scanner-idle-icon{
      width:80px;height:80px;
      border:3px solid rgba(255,255,255,0.15);
      border-radius:20px;
      display:flex;align-items:center;justify-content:center;
      font-size:2rem;
    }
    .scanner-idle p{font-size:0.85rem;line-height:1.5}

    /* Camera feed simulation */
    .camera-feed{
      display:none;
      width:100%;height:320px;
      position:relative;
      background:#0a0a0a;
      overflow:hidden;
    }
    .camera-feed.active{display:block}

    /* Viewfinder */
    .viewfinder{
      position:absolute;
      top:50%;left:50%;
      transform:translate(-50%,-50%);
      width:200px;height:200px;
    }
    .vf-corner{
      position:absolute;
      width:24px;height:24px;
      border-color:var(--red);border-style:solid;
    }
    .vf-corner.tl{top:0;left:0;border-width:3px 0 0 3px;border-top-left-radius:4px}
    .vf-corner.tr{top:0;right:0;border-width:3px 3px 0 0;border-top-right-radius:4px}
    .vf-corner.bl{bottom:0;left:0;border-width:0 0 3px 3px;border-bottom-left-radius:4px}
    .vf-corner.br{bottom:0;right:0;border-width:0 3px 3px 0;border-bottom-right-radius:4px}
    .vf-scan-line{
      position:absolute;
      left:0;right:0;height:2px;
      background:linear-gradient(90deg,transparent,var(--red),transparent);
      top:0;
      animation:scanLine 2s ease-in-out infinite;
    }
    @keyframes scanLine{
      0%{top:0;opacity:1}
      90%{top:100%;opacity:1}
      100%{top:100%;opacity:0}
    }
    .camera-hint{
      position:absolute;bottom:1.5rem;left:0;right:0;
      text-align:center;
      font-size:0.78rem;color:rgba(255,255,255,0.5);
      font-weight:600;text-transform:uppercase;letter-spacing:0.08em;
    }
    .camera-grid{
      position:absolute;inset:0;
      background-image:
        linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);
      background-size:40px 40px;
    }

    /* Result overlay */
    .result-overlay{
      position:absolute;inset:0;
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      gap:1rem;
      opacity:0;pointer-events:none;
      transition:opacity 0.3s;
    }
    .result-overlay.show{opacity:1;pointer-events:all}
    .result-overlay.valid{background:rgba(5,150,105,0.95)}
    .result-overlay.invalid{background:rgba(220,38,38,0.95)}

    .result-icon{
      width:80px;height:80px;
      background:rgba(255,255,255,0.2);
      border-radius:50%;
      display:flex;align-items:center;justify-content:center;
      font-size:2.5rem;
    }
    .result-text{
      font-family:"Bebas Neue",sans-serif;
      font-size:2.2rem;color:white;letter-spacing:1px;
    }
    .result-sub{
      font-size:0.85rem;color:rgba(255,255,255,0.8);
      font-weight:600;
    }
    .result-countdown{
      width:40px;height:40px;
      border:3px solid rgba(255,255,255,0.3);
      border-radius:50%;
      display:flex;align-items:center;justify-content:center;
      font-family:"Bebas Neue",sans-serif;
      font-size:1.2rem;color:white;
    }

    /* Scanner bottom */
    .scanner-bottom{
      padding:1.2rem 2rem;
      display:flex;align-items:center;justify-content:space-between;
      background:var(--off-white);
      flex-wrap:wrap;gap:0.8rem;
    }
    .scanner-status{display:flex;align-items:center;gap:8px;font-size:0.82rem;font-weight:600}
    .status-dot{width:8px;height:8px;border-radius:50%}
    .status-dot.green{background:var(--success);box-shadow:0 0 0 3px rgba(5,150,105,0.2)}
    .status-dot.gray{background:var(--gray-light)}
    .btn-stop{
      background:transparent;color:var(--danger);
      border:1.5px solid var(--danger);
      padding:7px 18px;border-radius:8px;
      font-weight:700;font-size:0.8rem;
      cursor:pointer;font-family:"Barlow",sans-serif;
      transition:all 0.2s;display:none;
    }
    .btn-stop.show{display:block}
    .btn-stop:hover{background:var(--danger-bg)}

    /* ── STATS ROW ── */
    .stats-row{
      display:grid;grid-template-columns:repeat(3,1fr);
      gap:1rem;
      animation:fadeUp 0.5s 0.1s ease both;
    }
    .stat-card{
      background:var(--white);
      border:1.5px solid var(--border);
      border-radius:14px;padding:1.2rem 1.4rem;
      transition:transform 0.2s;
    }
    .stat-card:hover{transform:translateY(-2px)}
    .stat-num{
      font-family:"Bebas Neue",sans-serif;
      font-size:2.2rem;line-height:1;
      color:var(--red);margin-bottom:3px;
    }
    .stat-label{font-size:0.75rem;font-weight:700;color:var(--gray-light);text-transform:uppercase;letter-spacing:0.08em}

    /* ── HISTORIAL ── */
    .historial-card{
      background:var(--white);
      border:1.5px solid var(--border);
      border-radius:20px;overflow:hidden;
      animation:fadeUp 0.5s 0.2s ease both;
    }
    .historial-header{
      padding:1.2rem 1.6rem;
      border-bottom:1px solid var(--border);
      display:flex;align-items:center;justify-content:space-between;
    }
    .historial-title{
      font-family:"Barlow Condensed",sans-serif;
      font-size:1rem;font-weight:800;
      text-transform:uppercase;letter-spacing:0.06em;
    }
    .historial-count{
      font-size:0.75rem;font-weight:700;
      background:var(--red-light);color:var(--red);
      padding:3px 10px;border-radius:100px;
    }
    .historial-list{max-height:320px;overflow-y:auto}

    .historial-item{
      display:flex;align-items:center;gap:12px;
      padding:0.9rem 1.6rem;
      border-bottom:1px solid var(--border);
      transition:background 0.15s;
    }
    .historial-item:last-child{border-bottom:none}
    .historial-item:hover{background:var(--off-white)}

    .hist-result-icon{
      width:36px;height:36px;border-radius:50%;
      display:flex;align-items:center;justify-content:center;
      font-size:0.9rem;flex-shrink:0;font-weight:700;
    }
    .hist-result-icon.valid{background:var(--success-bg);color:var(--success)}
    .hist-result-icon.invalid{background:var(--danger-bg);color:var(--danger)}

    .hist-info{flex:1}
    .hist-result-text{
      font-size:0.85rem;font-weight:700;
      color:var(--black);margin-bottom:1px;
    }
    .hist-result-text.valid{color:var(--success)}
    .hist-result-text.invalid{color:var(--danger)}
    .hist-time{font-size:0.75rem;color:var(--gray-light)}
    .hist-id{
      font-size:0.72rem;font-weight:700;
      color:var(--gray-light);font-family:"Barlow Condensed",sans-serif;
      letter-spacing:0.5px;
    }

    /* ── RIGHT PANEL ── */
    .right-panel{display:flex;flex-direction:column;gap:1.5rem}

    /* Comercio info */
    .comercio-card{
      background:var(--white);
      border:1.5px solid var(--border);
      border-radius:16px;overflow:hidden;
      animation:fadeUp 0.5s 0.05s ease both;
    }
    .comercio-card-header{
      background:var(--black);
      padding:1.4rem;
      display:flex;align-items:center;gap:12px;
    }
    .comercio-avatar{
      width:48px;height:48px;border-radius:12px;
      background:var(--red);
      display:flex;align-items:center;justify-content:center;
      font-size:1.3rem;flex-shrink:0;
    }
    .comercio-name-wrap{}
    .comercio-name{
      font-family:"Barlow Condensed",sans-serif;
      font-size:1.1rem;font-weight:800;
      text-transform:uppercase;letter-spacing:0.04em;
      color:white;
    }
    .comercio-cat{font-size:0.75rem;color:rgba(255,255,255,0.5);margin-top:2px}
    .comercio-badge{
      margin-left:auto;
      background:rgba(74,222,128,0.15);
      border:1px solid rgba(74,222,128,0.3);
      color:#4ADE80;
      font-size:0.68rem;font-weight:700;
      padding:4px 10px;border-radius:100px;
      text-transform:uppercase;letter-spacing:0.05em;white-space:nowrap;
    }
    .comercio-card-body{padding:1.2rem 1.4rem}
    .comercio-detail-row{
      display:flex;justify-content:space-between;
      padding:0.5rem 0;font-size:0.82rem;
    }
    .comercio-detail-row:not(:last-child){border-bottom:1px solid var(--border)}
    .comercio-detail-label{color:var(--gray-light);font-weight:600}
    .comercio-detail-value{color:var(--black);font-weight:700;text-align:right}

    /* Tips card */
    .tips-card{
      background:var(--white);
      border:1.5px solid var(--border);
      border-radius:16px;padding:1.4rem;
      animation:fadeUp 0.5s 0.15s ease both;
    }
    .tips-title{
      font-family:"Barlow Condensed",sans-serif;
      font-size:0.95rem;font-weight:800;
      text-transform:uppercase;letter-spacing:0.06em;
      margin-bottom:1rem;
      display:flex;align-items:center;gap:8px;
    }
    .tips-list{display:flex;flex-direction:column;gap:0.7rem}
    .tip-item{
      display:flex;gap:10px;align-items:flex-start;
      font-size:0.82rem;color:var(--gray);line-height:1.5;
    }
    .tip-bullet{
      width:20px;height:20px;min-width:20px;
      border-radius:50%;background:var(--red-light);
      display:flex;align-items:center;justify-content:center;
      font-size:0.7rem;color:var(--red);font-weight:700;
      margin-top:1px;
    }

    /* Promo reminder */
    .promo-card{
      background:linear-gradient(135deg,var(--red),var(--red-dark));
      border-radius:16px;padding:1.4rem;color:white;
      animation:fadeUp 0.5s 0.2s ease both;
    }
    .promo-title{
      font-family:"Bebas Neue",sans-serif;
      font-size:1.4rem;letter-spacing:0.5px;margin-bottom:0.5rem;
    }
    .promo-desc{font-size:0.82rem;color:rgba(255,255,255,0.8);line-height:1.6;margin-bottom:1rem}
    .promo-note{
      background:rgba(255,255,255,0.15);
      border-radius:8px;padding:0.8rem;
      font-size:0.78rem;color:rgba(255,255,255,0.9);
      line-height:1.5;font-style:italic;
    }

    /* ── TOAST ── */
    .toast{
      position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(20px);
      background:var(--black);color:white;
      padding:12px 24px;border-radius:100px;
      font-size:0.85rem;font-weight:600;
      opacity:0;pointer-events:none;transition:all 0.3s;z-index:999;
      display:flex;align-items:center;gap:8px;white-space:nowrap;
    }
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

    @media(max-width:900px){
      .layout{grid-template-columns:1fr}
      .right-panel{order:-1}
      .stats-row{grid-template-columns:repeat(3,1fr)}
      .topbar-nav{display:none}
    }
    @media(max-width:480px){
      .stats-row{grid-template-columns:1fr 1fr}
      .stat-card:last-child{grid-column:span 2}
      .layout{padding:1rem 1rem 2rem}
    }
  </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <div class="topbar-left">
    <a href="index.html" class="topbar-logo">
      <img src="data:image/jpeg;base64," alt="ChatCAR"/>
      <span class="topbar-logo-name">ChatCAR</span>
    </a>
    <div class="topbar-sep"></div>
    <span class="topbar-biz">GNC Quilmes Centro</span>
  </div>
  <div class="topbar-right">
    <div class="topbar-nav">
      <a href="#" class="active">Escanear</a>
      <a href="#">Historial</a>
      <a href="#">Mi comercio</a>
    </div>
    <div class="topbar-avatar" title="GNC Quilmes">GQ</div>
  </div>
</div>

<!-- LAYOUT -->
<div class="layout">

  <!-- ══ COLUMNA IZQUIERDA ══ -->
  <div class="scanner-section">

    <div class="section-header">
      <div class="section-tag">Panel de comercio</div>
      <h1 class="section-title">Escáner de Credenciales</h1>
    </div>

    <!-- STATS -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-num" id="statHoy">0</div>
        <div class="stat-label">Validaciones hoy</div>
      </div>
      <div class="stat-card">
        <div class="stat-num" id="statMes">87</div>
        <div class="stat-label">Este mes</div>
      </div>
      <div class="stat-card">
        <div class="stat-num" id="statTotal">341</div>
        <div class="stat-label">Total acumulado</div>
      </div>
    </div>

    <!-- SCANNER CARD -->
    <div class="scanner-card">
      <div class="scanner-top">
        <div class="scanner-top-left">
          <h3>Lector de código QR</h3>
          <p>Apuntá la cámara al QR del carnet del socio conductor</p>
        </div>
        <button class="btn-scan" id="btnScan" onclick="startScanner()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/>
            <rect x="7" y="7" width="10" height="10" rx="1"/>
          </svg>
          Iniciar escáner
        </button>
      </div>

      <!-- Viewport -->
      <div class="scanner-viewport" id="scannerViewport">
        <!-- Estado idle -->
        <div class="scanner-idle" id="scannerIdle">
          <div class="scanner-idle-icon">📷</div>
          <p>Presioná <strong>"Iniciar escáner"</strong> para activar la cámara y leer el código QR del carnet</p>
        </div>

        <!-- Camera feed -->
        <div class="camera-feed" id="cameraFeed">
          <div class="camera-grid"></div>
          <div class="viewfinder">
            <div class="vf-corner tl"></div>
            <div class="vf-corner tr"></div>
            <div class="vf-corner bl"></div>
            <div class="vf-corner br"></div>
            <div class="vf-scan-line"></div>
          </div>
          <div class="camera-hint">Apuntá al código QR del carnet</div>
        </div>

        <!-- Resultado VÁLIDO -->
        <div class="result-overlay valid" id="resultValid">
          <div class="result-icon">✓</div>
          <div class="result-text">CUENTA ACTIVA</div>
          <div class="result-sub">El socio puede acceder al beneficio</div>
          <div class="result-countdown" id="countdownValid">3</div>
        </div>

        <!-- Resultado INVÁLIDO -->
        <div class="result-overlay invalid" id="resultInvalid">
          <div class="result-icon">✗</div>
          <div class="result-text">CUENTA INACTIVA</div>
          <div class="result-sub">La decisión de otorgar el beneficio queda a tu criterio</div>
          <div class="result-countdown" id="countdownInvalid">3</div>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="scanner-bottom">
        <div class="scanner-status">
          <div class="status-dot gray" id="statusDot"></div>
          <span id="statusText">Escáner inactivo</span>
        </div>
        <div style="display:flex;gap:0.6rem;align-items:center">
          <!-- Demo buttons -->
          <button onclick="simulateResult(true)" style="
            background:var(--success-bg);color:var(--success);
            border:1.5px solid var(--success);padding:7px 14px;
            border-radius:8px;font-weight:700;font-size:0.75rem;
            cursor:pointer;font-family:'Barlow',sans-serif;
            transition:all 0.2s;
          ">Demo: Activa</button>
          <button onclick="simulateResult(false)" style="
            background:var(--danger-bg);color:var(--danger);
            border:1.5px solid var(--danger);padding:7px 14px;
            border-radius:8px;font-weight:700;font-size:0.75rem;
            cursor:pointer;font-family:'Barlow',sans-serif;
            transition:all 0.2s;
          ">Demo: Inactiva</button>
          <button class="btn-stop" id="btnStop" onclick="stopScanner()">■ Detener</button>
        </div>
      </div>
    </div>

    <!-- HISTORIAL -->
    <div class="historial-card">
      <div class="historial-header">
        <span class="historial-title">Últimas validaciones</span>
        <span class="historial-count" id="histCount">0 hoy</span>
      </div>
      <div class="historial-list" id="historialList">
        <div style="padding:2.5rem;text-align:center;color:var(--gray-light);font-size:0.85rem">
          Aún no hay validaciones hoy. Usá el escáner para comenzar.
        </div>
      </div>
    </div>

  </div>
  <!-- /scanner-section -->

  <!-- ══ COLUMNA DERECHA ══ -->
  <div class="right-panel">

    <!-- Info del comercio -->
    <div class="comercio-card">
      <div class="comercio-card-header">
        <div class="comercio-avatar">⛽</div>
